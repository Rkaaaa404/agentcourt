# ==============================================================================
# AgentCourt Environment Configuration (SANDBOX ONLY)
# ==============================================================================

# PayPal Sandbox API Configuration
# Base URL is strictly restricted to sandbox: https://api-m.sandbox.paypal.com
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_MERCHANT_EMAIL=merchant@sandbox.paypal.com
PAYPAL_BUYER_EMAIL=buyer@sandbox.paypal.com
PAYPAL_BUYER_PASSWORD=buyer_sandbox_password
PAYPAL_WEBHOOK_ID=

# Server & App Config
PORT=8000
HOST=0.0.0.0
APP_URL=http://localhost:8000
DATABASE_URL=sqlite:///./agentcourt.db

# LLM Configuration (Optional: fallback deterministic arbiter runs if omitted)
# Supported LLM_PROVIDER: gemini, anthropic, openai
# Gemini key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-pro-preview
LLM_API_KEY=

# Agent / Regret Thresholds
REGRET_THRESHOLD=0.15
